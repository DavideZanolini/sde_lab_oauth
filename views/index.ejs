<!doctype html>
<html>
  <head>
    <meta charset="utf-8" />
    <title>Home</title>
  </head>
  <body>
    <h1>Home</h1>
    <% if (user) { %>
      <p>Signed in as <strong><%= user.displayName %></strong></p>
      <p><a href="/redirect">Redirect page</a></p>
      <p><a href="/logout">Logout</a></p>
    <% } else { %>
      <p>You are not signed in.</p>
      <p><a href="/login">Sign in with Google</a></p>
    <% } %>
  </body>
  </html>
