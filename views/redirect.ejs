<!doctype html>
<html>
  <head>
    <meta charset="utf-8" />
    <title>Redirect</title>
  </head>
  <body>
    <h1>Redirect Page</h1>
    <% if (user) { %>
      <p>Welcome, <strong><%= user.displayName %></strong></p>
      <p>Email: <%= (user.emails && user.emails[0] && user.emails[0].value) || 'N/A' %></p>
    <% } else { %>
      <p>No user data available.</p>
    <% } %>
    <p><a href="/">Home</a></p>
  </body>
  </html>
